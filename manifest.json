{
    "manifest_version": 3,
    "name": "SprintSynapse Professional",
    "version": "1.0",
    "description": "AI-powered sprint analysis and status updates",
    
    "permissions": [
        "activeTab",
        "storage",
        "contextMenus"
    ],
    
    "action": {
        "default_popup": "popup.html",
        "default_title": "SprintSynapse"
    },
    
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_end"
        }
    ],
    
    "background": {
        "service_worker": "background.js"
    },
    
    "icons": {
        "25": "icons/icon25.png",
        "125": "icons/icon125.png"
    }
}